  "cards": [
    {
      "dot": "cyan",
      "title": "Primary telemetry path",
      "items": [
        "+layout.svelte polls /api/mavlink/heartbeat every 1.1 s",
        "Server drains S.newLogs[] — MAVLink log strings serialised by node-mavlink",
        "getLogs() regex-dispatches to per-message-type handlers",
        "Handlers call mavlinkStore.set() → Svelte reactivity updates all components"
      ]
    },
    {
      "dot": "emerald",
      "title": "MAVLink Library (lib/server/mavlink.ts)",
      "items": [
        "Singleton state on globalThis.__mav — survives Vite HMR reloads",
        "Transports: UDP dgram (default :14550), SerialPort (USB VID auto-detect), TCP net.Socket",
        "USB hotplug watcher: scans SerialPort.list() every 2 s, auto-connects on new device",
        "Sends MAV_CMD_SET_MESSAGE_INTERVAL (CMD 511) for each stream on connect (4 Hz attitude, 2 Hz battery, etc.)",
        "Sends 1 Hz MAVLink heartbeat to FC so it keeps sending telemetry"
      ]
    },
    {
      "dot": "amber",
      "title": "Arming sequence (no RC required)",
      "items": [
        "Write ARMING_CHECK=0 → wait 200 ms (disables RC pre-arm check)",
        "Send COMPONENT_ARM_DISARM(1, 21196) with force flag",
        "Wait 1 s → restore ARMING_CHECK=1",
        "RTLL: DO_SET_MODE LOITER at ≤20% battery, then RTL after 30 s"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Browser never opens a socket to the FC — all MAVLink I/O is server-side",
        "Video bypasses SvelteKit: browser embeds MediaMTX iframe (cross-origin HTTP :8889)",
        "Weather & Nominatim fetched directly from browser (internet, no server proxy)",
        "Tile fetches proxied and cached by SvelteKit server for offline-capable operation"
      ]
    }
  ]
