# ─── Sidak GCS — Environment Configuration ───────────────────────────────────
# Copy this file to .env and fill in your values.
# VITE_* variables are bundled into the client-side build (visible in browser).
# All others are server-only.

# ── MAVLink / Serial ──────────────────────────────────────────────────────────
# Override the auto-detected serial port (e.g. COM3 on Windows, /dev/ttyACM0 on Linux).
# Leave blank to use auto-detection.
USB_SERIAL_PORT=

# Serial baud rate for the flight controller (default: 115200).
USB_BAUD_RATE=115200

# ── Video Feed ────────────────────────────────────────────────────────────────
# Port number of the video stream server (default: 8889).
VITE_VIDEO_PORT=8889

# URL path segment for the stream endpoint (default: cam).
VITE_VIDEO_PATH=cam

# ── 3D Map (MapTiler) ─────────────────────────────────────────────────────────
# API key for MapTiler (used by the 3D map view).
# Register for a free key at https://www.maptiler.com/
VITE_MAPTILER_KEY=

# ── Altitude Angel Airspace Data (optional) ───────────────────────────────────
# API key for Altitude Angel airspace overlay data.
# See https://www.altitudeangel.com/
VITE_ALTITUDE_ANGEL_API_KEY=

# ── Node.js ───────────────────────────────────────────────────────────────────
# Set to "production" for deployment builds.
NODE_ENV=development
