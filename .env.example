# ============================================================
# Sidak GCS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# MAVLink USB serial port path.
# Leave blank to enable auto-detection (CubePilot VID 2DAE).
# Windows example: COM47
# Linux example:   /dev/ttyUSB0
USB_SERIAL_PORT=

# Serial baud rate for the MAVLink connection (default: 115200)
USB_BAUD_RATE=115200

# Altitude Angel airspace API key (optional — required for airspace overlay)
# Obtain from: https://www.altitudeangel.com/
ALTITUDE_ANGEL_API_KEY=
